# Configuración de la aplicación Multi-Agente Cripto
# Introduce aquí tu clave de Google Gemini (puedes conseguirla gratis en Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Umbral porcentual de subida en 24h para activar la investigación de los agentes (ejemplo: 5.0)
PRICE_ALERT_THRESHOLD=5.0

# Puerto del servidor web
PORT=8000
